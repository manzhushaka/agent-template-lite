[Unit]
Description=Agent Template visitor chat
After=network-online.target agent-template-agentos.service
Wants=network-online.target

[Service]
Type=simple
User=codex-ops
Group=codex-ops
WorkingDirectory=/home/app/agent-template/current/apps/chat
EnvironmentFile=/home/app/agent-template/shared/.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=PATH=/home/middleware/node/current/bin:/home/middleware/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/middleware/node/current/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
