[Unit]
Description=agent-template-lite Chat
After=network.target agent-template-lite-agentos.service

[Service]
Type=simple
User=agent-template-lite
WorkingDirectory=/home/app/agent-template-lite/current/apps/chat
EnvironmentFile=/home/app/agent-template-lite/shared/.env
ExecStart=/usr/local/bin/pnpm --dir /home/app/agent-template-lite/current --filter @template/chat start
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
