{
  "name": "@template/console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${CONSOLE_PORT:-3001}",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "PORT=${CONSOLE_PORT:-3001} node .next/standalone/apps/console/server.js",
    "lint": "eslint src scripts drizzle.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@template/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "mysql2": "^3.14.4",
    "next": "^15.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
