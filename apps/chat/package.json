{
  "name": "@template/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${CHAT_PORT:-3000}",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "PORT=${CHAT_PORT:-3000} node .next/standalone/apps/chat/server.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@template/shared": "workspace:*",
    "lucide-react": "^0.544.0",
    "next": "^15.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
