PROJECT_NAME=agent-template
PROJECT_TYPE=node-service
RUNTIME=node
RUNTIME_VERSION=22
HEALTHCHECK_URL=http://127.0.0.1:8000/api/health
PUBLIC_HEALTH_URL=https://manzhushaka.cn/gateway/agent-template/chat/
MAX_RELEASE_ARCHIVE_MIB=600
REMOTE_RUNTIME_PATH=/home/middleware/node/current/bin/node
REMOTE_UV_PATH=/home/middleware/bin/uv
REMOTE_REQUIRED_PATHS=/home/middleware/node/current/bin/node\ /home/middleware/bin/uv\ /home/middleware/nginx/current/sbin/nginx
REMOTE_REQUIRED_UNITS=agent-template-agentos.service\ agent-template-chat.service\ agent-template-console.service\ agent-template-worker.service
REMOTE_NGINX_PATHS=/home/middleware/nginx/conf/conf.d/agent-template.locations.conf
REMOTE_MIN_FREE_MIB=2048
REQUIRE_APP_ENV=true
