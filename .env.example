# Project identity. The builder Skill replaces these values after business and naming confirmation.
PROJECT_SLUG=agent-template-lite
PROJECT_NAME=智能业务助手

# MySQL stores business data, Console accounts, audit events and knowledge metadata.
MYSQL_URL=mysql://agent_demo:change-me@127.0.0.1:3306/agent_demo
AGENT_DATABASE_URL=mysql+pymysql://agent_demo:change-me@127.0.0.1:3306/agent_demo

# Browser and internal-service secrets must be independent random values in production.
AUTH_SECRET=replace-with-at-least-32-random-characters
CHAT_VISITOR_SECRET=replace-with-a-chat-visitor-signing-secret
INTERNAL_API_TOKEN=replace-with-an-independent-random-token
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-admin-password

# Real model access is mandatory. OpenAI-compatible providers such as MiniMax are supported.
MODEL_NAME=MiniMax-M2.7-highspeed
MODEL_BASE_URL=https://api.minimaxi.com/v1
MODEL_API_KEY=

CHAT_PORT=3000
CONSOLE_PORT=3001
AGENTOS_PORT=8000
CHAT_BASE_PATH=
NEXT_PUBLIC_CHAT_BASE_PATH=
CONSOLE_BASE_PATH=
NEXT_PUBLIC_CONSOLE_BASE_PATH=
CONSOLE_URL=http://127.0.0.1:3001
AGENTOS_URL=http://127.0.0.1:8000
AGENTOS_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
LANCEDB_URI=../../var/lancedb
